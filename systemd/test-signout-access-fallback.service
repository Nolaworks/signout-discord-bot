[Unit]
Description=Test Signout Access Fallback Connector
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=signout
EnvironmentFile=/opt/signout/signout-discord-bot/.env
WorkingDirectory=/opt/signout/signout-discord-bot
Environment=PYTHONPATH=/opt/signout/signout-discord-bot
ExecStart=/opt/signout/signout-discord-bot/.bot-venv/bin/python3 /opt/signout/signout-discord-bot/scripts/fallback_access_connector.py
Restart=always
RestartSec=5
Nice=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
